{
  "manifest_version": 3,
  "name": "Squeeze",
  "version": "1.0.0",
  "description": "Optimize chatbot prompts for maximum token efficiency and clarity on Claude.ai.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://openrouter.ai/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "Premium/premium-gate.js",
        "SmartRouter/router-config.js",
        "SmartRouter/router-core.js",
        "SmartRouter/router-stats.js",
        "SmartRouter/router-ui.js"
      ],
      "css": [
        "SmartRouter/router-ui.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
