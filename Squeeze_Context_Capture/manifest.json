{
  "manifest_version": 3,
  "name": "Squeeze (Context Capture Dev)",
  "version": "0.9.0",
  "description": "Optimize chatbot prompts locally for maximum token efficiency and clarity on Claude.ai.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["pdf.min.js", "modules/engine/textrank-summarizer.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "Premium/premium-gate.js",
        "SmartRouter/router-config.js",
        "SmartRouter/router-core.js",
        "SmartRouter/router-stats.js",
        "SmartRouter/router-ui.js"
      ],
      "css": [
        "SmartRouter/router-ui.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/icon16.png", "icons/icon48.png", "icons/icon128.png", "pdf.worker.min.js"],
      "matches": ["https://claude.ai/*", "https://gemini.google.com/*"]
    }
  ]
}
